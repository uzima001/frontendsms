# SMS Gateway Platform Environment Configuration

# Server
PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://gateway_user:SecretPassword123!@localhost:5432/sms_gateway_db?schema=public

# Queue & Cache
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super_secret_production_jwt_signing_key_32chars
DEVICE_AUTH_SECRET=device_encryption_master_secret_2026

# Public URLs
APP_URL=https://gateway.yourdomain.com
API_URL=https://api.yourdomain.com
WEBSOCKET_URL=wss://api.yourdomain.com

# AI Provider (Google Gemini API via @google/genai)
GEMINI_API_KEY=your_gemini_api_key_here
